<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Línea vertical invisible al 50 % de la pantalla para repatir
         los botones en dos columnas -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guiaCentro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Logo de EvenToGo"
            android:src="@drawable/event_icon3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bienvenido a\nEvenToGo"
            android:textAlignment="center"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <TextView
            android:id="@+id/slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:text="@string/slogan"
            android:textAlignment="center"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.526"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/welcome" />

        <Button
            android:id="@+id/btnNuevoEvento"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/lila"
            android:text="Nuevo Evento"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guiaCentro"
            app:layout_constraintTop_toBottomOf="@+id/slogan"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="2dp" />


        <Button
            android:id="@+id/btnSelectEvent"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/lila"
            android:text="@string/selec"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toEndOf="@id/guiaCentro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/slogan"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/lila"
            android:text="Descubre la Web"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guiaCentro"
            app:layout_constraintTop_toBottomOf="@+id/btnNuevoEvento"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="2dp" />


        <Button
            android:id="@+id/btnAcercaDe"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:backgroundTint="@color/lila"
            android:text="Acerca de"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toEndOf="@id/guiaCentro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnSelectEvent"
            app:layout_constraintTop_toTopOf="@id/btnWeb"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/txtContador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Eventos Registrados: 0"
            android:textColor="@color/colorPrimary"
            android:textSize="16dp"
            android:textStyle="bold"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guiaCentro"
            app:layout_constraintTop_toBottomOf="@+id/btnWeb" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/lila"
            android:text="Reset"
            android:textColor="@color/black"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toEndOf="@id/guiaCentro"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAcercaDe"
            app:layout_constraintTop_toTopOf="@id/txtContador"
            app:layout_constraintBottom_toBottomOf="@id/txtContador"
            app:strokeColor="@color/colorPrimaryDark"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/txtDestino"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="40dp"
            android:background="@color/gray"
            android:gravity="center"
            android:text="Suelta aquí 'Acerca de'"
            android:textAlignment="center"
            android:textColor="@color/dark_gray"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnReset"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtCreado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/creado_por"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtDestino"
            tools:layout_editor_absoluteX="118dp"
            tools:ignore="MissingConstraints" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>